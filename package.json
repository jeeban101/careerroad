    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mammoth": "^1.11.0",
    "memoizee": "^0.4.17",
    "multer": "^2.0.2",
    "openid-client": "^6.6.2",
    "passport": "^0.7.0",
